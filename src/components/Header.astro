---
import { localPath } from '../data/linguistpro';
const lang = (Astro.currentLocale ?? 'en') as 'en' | 'ru';
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
// Path without the locale prefix, used to build the EN/RU counterparts.
const basePath = (pathname === '/ru' || pathname.startsWith('/ru/')) ? (pathname.slice(3) || '/') : pathname;
const enUrl = localPath('en', basePath);
const ruUrl = localPath('ru', basePath);
// Localize an EN href for the current locale.
const p = (href: string) => localPath(lang, href);

const labels = {
  en: { home: 'Home', products: 'Products', technology: 'Technology', about: 'About', contact: 'Contact', studio: 'Studio', room: 'Reading Room', guides: 'Guides', agents: 'For AI' },
  ru: { home: 'Главная', products: 'Продукты', technology: 'Технологии', about: 'О студии', contact: 'Контакты', studio: 'Студия', room: 'Читальный зал', guides: 'Практика', agents: 'Для ИИ' },
}[lang];
const links = [
  { key: 'studio', href: '/products/linguistpro' },
  { key: 'room', href: '/products/reading-room' },
  { key: 'guides', href: '/guides' },
  { key: 'agents', href: '/agents' },
] as const;
const isActive = (href: string) => {
  const target = p(href).replace(/\/$/, '') || '/';
  if (href === '/') return pathname === target;
  return pathname === target || pathname.startsWith(`${target}/`);
};
---
<header>
  <nav aria-label={lang === 'ru' ? 'Основная навигация' : 'Main navigation'}>
    <a href={p('/')} class="brand">
      <svg class="brand-mark" width="26" height="26" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
        <defs>
          <linearGradient id="kbrand" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#2dd4bf" />
            <stop offset="1" stop-color="#0f766e" />
          </linearGradient>
        </defs>
        <rect width="64" height="64" rx="16" fill="url(#kbrand)" />
        <path d="M23 15 V49 M23 32 L41 15 M28 30 L42 49" fill="none" stroke="#ffffff" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      <span>Kolosei</span>
    </a>
    <ul>
      {links.map((l) => (
        <li><a href={p(l.href)} aria-current={isActive(l.href) ? 'page' : undefined}>{labels[l.key]}</a></li>
      ))}
    </ul>
    <div class="lang-switch" aria-label={lang === 'ru' ? 'Язык сайта' : 'Site language'}>
      <a href={enUrl} aria-current={lang === 'en' ? 'page' : undefined} hreflang="en">EN</a><span aria-hidden="true">·</span><a href={ruUrl} aria-current={lang === 'ru' ? 'page' : undefined} hreflang="ru">RU</a>
    </div>
  </nav>
</header>

<style>
  header {
    border-bottom: 1px solid var(--border);
    background: var(--bg);
  }
  nav {
    max-width: var(--max-width-wide);
    margin: 0 auto;
    padding: 1rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .brand {
    margin-right: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    font-size: 1.1rem;
    color: var(--fg);
    border-bottom: none;
  }
  .brand-mark { display: block; flex: none; border-radius: 6px; }
  ul {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0;
    margin: 0;
  }
  ul a {
    color: var(--fg-soft);
    font-size: 0.95rem;
    border-bottom: none;
  }
  ul a:hover { color: var(--fg); }
  ul a[aria-current='page'] { color: var(--fg); font-weight: 500; }
  .lang-switch {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    padding-left: 0.5rem;
    border-left: 1px solid var(--border);
  }
  nav { flex-wrap: wrap; }
  ul { flex-wrap: wrap; }
  ul a { display: inline-block; padding: .45rem 0; }
  .lang-switch span { color: var(--fg-muted); }
  .lang-switch a { color: var(--fg-muted); }
  .lang-switch a[aria-current='page'] { color: var(--accent); font-weight: 600; }
  .lang-switch a { display: inline-block; padding: .45rem .1rem; }
  @media (max-width: 600px) {
    nav > ul { order: 2; width: 100%; gap: .9rem; }
    .lang-switch { order: 1; }
  }
</style>
