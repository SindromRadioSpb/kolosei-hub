---
import BaseLayout from '../layouts/BaseLayout.astro';
import { facts, corpora, capabilities, corpusUrl, localPath } from '../data/linguistpro';
const { lang = 'en' } = Astro.props as { lang: 'en' | 'ru' };
const ru = lang === 'ru', p = (path: string) => localPath(lang, path);
---
<BaseLayout title={ru ? 'LinguistPro для ИИ и агентов — факты и доступ' : 'LinguistPro for AI assistants and agents — facts and access'} description={ru ? 'Проверяемая справка LinguistPro: возможности Студии и Зала, публичные корпуса, JSON и Markdown, источники и границы владельческого MCP-пилота.' : 'A checkable LinguistPro reference: Studio and Reading Room capabilities, public collections, JSON and Markdown, sources and owner-pilot MCP boundaries.'}>
  <nav class="breadcrumbs" aria-label={ru ? 'Путь к странице' : 'Breadcrumb'}><a href={p('/')}>Kolosei</a> / {ru ? 'Для ИИ и агентов' : 'For AI and agents'}</nav>
  <h1>{ru ? 'LinguistPro для людей и агентов' : 'LinguistPro for people and agents'}</h1>
  <p class="lead">{facts.summary[lang]}</p>
  <p class="source-note">{ru ? 'Проверено' : 'Reviewed'} <time datetime={facts.reviewed}>{facts.reviewed}</time>. {ru ? 'Издатель: Kolosei. Основатель: Пётр Колосей.' : 'Publisher: Kolosei. Founder: Peter Kolosei.'}</p>
  <div class="btn-row"><a class="btn btn-primary" href="/llms-full.txt">{ru ? 'Полная справка Markdown' : 'Full Markdown reference'}</a><a class="btn btn-secondary" href="/facts/linguistpro.json">{ru ? 'Факты в JSON' : 'Product facts in JSON'}</a><a class="btn btn-secondary" href="/llms.txt">llms.txt</a></div>
  <h2 id="access">{ru ? 'Два разных уровня доступа' : 'Two distinct access levels'}</h2>
  <h3>{ru ? 'Читать публичную справку' : 'Read public information'}</h3><p>{ru ? 'Страницы сайта, Markdown и JSON доступны без авторизации. Ассистент с веб-доступом может получить их по ссылке и использовать как источник описания продукта. Все форматы формируются из общей проверенной базы фактов.' : 'Website pages, Markdown and JSON are available without authentication. A web-enabled assistant can retrieve them by URL and use them as a source about the product. The formats share the same reviewed factual source.'}</p>
  <h3>{ru ? 'Вызывать инструменты LinguistPro' : 'Call LinguistPro tools'}</h3><p>{ru ? 'OAuth/MCP — отдельный владельческий пилот с авторизацией и ограничениями прав. Для Hermes имеется подтверждение владельца; оно не означает общедоступности или проверки подключения ChatGPT, Gemini, Claude и всех других клиентов. Публичная самостоятельная регистрация MCP не объявлена.' : 'OAuth/MCP is a separate authenticated owner pilot with permission checks. Hermes has owner-reported acceptance; that does not establish general availability or verified ChatGPT, Gemini, Claude and other client connections. Public self-service MCP signup is not announced.'}</p>
  <p>{ru ? 'Публичный справочник не предоставляет доступ к личным заметкам, прогрессу, оценкам или ключам. Он также не даёт прав на перепубликацию текстов и аудио. Для материалов учитываются права конкретной публикации и выданный инструменту доступ.' : 'Public reference files grant no access to personal notes, progress, grades or keys, and no permission to redistribute texts or audio. Materials retain their publication-specific rights and tool authorization boundaries.'}</p>
  <h2 id="capabilities">{ru ? 'Что делает продукт' : 'What the product does'}</h2>
  {capabilities.map(c => <section id={c.id}><h3>{c.title[lang]}</h3><p>{c.text[lang]}</p></section>)}
  <h2 id="collections">{ru ? 'Опубликованные коллекции' : 'Published collections'}</h2>
  <ul>{corpora.map(c => <li><a href={corpusUrl(c.slug)}>{c.title[lang]}</a>: {c.count} {c.kind[lang]}. {c.description[lang]}</li>)}</ul>
  <p>{ru ? 'Каталог Бен-Иегуды:' : 'Ben-Yehuda catalog:'} {facts.catalogued} {ru ? 'записей,' : 'entries,'} {facts.prepared} {ru ? 'отмечены как подготовленные. Это не проверка наличия каждого производного файла или аудио.' : 'marked prepared. This is not verification of every derivative or audio asset.'}</p>
  <h2 id="sources">{ru ? 'Источники и цитирование' : 'Sources and citation'}</h2>
  <ul><li><a href={facts.publicationSource}>{ru ? 'Живой каталог публичных корпусов' : 'Live public corpus catalog'}</a></li><li><a href={facts.catalogSource}>{ru ? 'Каталог Бен-Иегуды, версия 7' : 'Ben-Yehuda catalog, version 7'}</a></li><li><a href={`${facts.repository}/tree/${facts.productSource}`}>{ru ? 'Проверенная опубликованная ревизия исходного кода' : 'Reviewed published source revision'}</a></li><li><a href={p('/privacy')}>{ru ? 'Конфиденциальность и обработка данных' : 'Privacy and data handling'}</a></li><li><a href="https://osf.io/zdv9j">{ru ? 'Пререгистрация исследования на OSF' : 'OSF research preregistration'}</a></li></ul>
  <p>{ru ? 'Для утверждений о продукте ссылайтесь на соответствующую страницу Студии или Зала. Для чисел — на датированный снимок и исходный каталог. Для произведения или задачи — на его источник. OSF подтверждает пререгистрацию методологии, но не измеренную эффективность обучения.' : 'Cite the Studio or Reading Room page for product claims, the dated snapshot and original catalog for counts, and the source item for a work or problem. OSF supports the methodology preregistration, not measured learning effectiveness.'}</p>
  <p>{facts.boundaries[lang]}</p>
  <h2>{ru ? 'Как передать справку ассистенту' : 'Share the reference with an assistant'}</h2><p>{ru ? 'Передайте ссылку на эту страницу с просьбой прочитать её и подобрать подходящий сценарий занятий. Если у ассистента нет веб-доступа, откройте полную справку Markdown и вставьте её в разговор. Подключение к личной учебной базе от этого не возникает.' : 'Share this page and ask the assistant to read it and suggest a suitable study workflow. If it cannot browse, open the full Markdown reference and paste it into the conversation. This does not connect your private learning workspace.'}</p>
  <div class="inline-links"><a href={p('/products/linguistpro')}>{ru ? 'Студия' : 'Studio'}</a><a href={p('/products/reading-room')}>{ru ? 'Читальный зал' : 'Reading Room'}</a><a href={p('/contact')}>{ru ? 'Вопросы о доступе' : 'Access questions'}</a></div>
</BaseLayout>
