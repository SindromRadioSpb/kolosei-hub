---
import BaseLayout from '../layouts/BaseLayout.astro';
import CorpusShelf from './CorpusShelf.astro';
import Questions from './Questions.astro';
import LearningFlow from './LearningFlow.astro';
import Screenshot from './Screenshot.astro';
import { facts, capabilities, localPath } from '../data/linguistpro';
const { lang = 'en', kind = 'studio' } = Astro.props as { lang: 'en' | 'ru'; kind: 'studio' | 'room' };
const ru = lang === 'ru', studio = kind === 'studio';
const p = (path: string) => localPath(lang, path);
const title = studio
  ? (ru ? 'Студия LinguistPro — ваши материалы для изучения иврита' : 'LinguistPro Studio — turn your sources into Hebrew study materials')
  : (ru ? 'Читальный зал — иврит с переводом, песнями и задачниками' : 'Hebrew Reading Room — literature, songs and bilingual problem books');
const description = studio ? capabilities[0].text[lang] : (ru ? 'Читайте иврит с огласовками, русским переводом и разбором слов: литература Бен-Иегуды, учебные песни, задачи по физике и материаловедению.' : 'Read Hebrew with niqqud, Russian translation and word explanations: Ben-Yehuda literature, Study Songs, Physics and Materials Science.');
---
<BaseLayout title={title} description={description} wide product>
  <nav class="breadcrumbs" aria-label={ru ? 'Путь к странице' : 'Breadcrumb'}><a href={p('/')}>Kolosei</a> / <a href={p('/products')}>{ru ? 'Продукты' : 'Products'}</a> / {studio ? 'LinguistPro' : (ru ? 'Читальный зал' : 'Reading Room')}</nav>
  <div class="product-opening"><p class="product-signature">LinguistPro <span>{studio ? (ru ? 'Студия' : 'Studio') : (ru ? 'Читальный зал' : 'Reading Room')}</span></p>
    <h1>{studio ? (ru ? 'Ваш интерес. Ваш материал. Ваш иврит.' : 'Your curiosity. Your material. Your Hebrew.') : (ru ? 'Откройте текст. Найдите свой иврит.' : 'Open a text. Find your Hebrew.')}</h1>
    <p class="lead">{studio ? (ru ? 'Превратите то, что важно именно вам, в материал для чтения и запоминания. От статьи и фотографии до лекции с субтитрами.' : 'Turn something that matters to you into material for reading and remembering. From an article or photo to a lecture with captions.') : (ru ? 'Готовые материалы помогают перейти от изучения языка к чтению на нём. Перевод, огласовки, аудио и объяснения слов доступны рядом с оригиналом — по мере необходимости.' : 'Prepared materials help you move from studying the language to reading in it. Translation, niqqud, audio and word explanations sit beside the original, ready when needed.')}</p>
    <div class="btn-row"><a class="btn btn-primary" href={studio ? facts.studio : facts.room}>{studio ? (ru ? 'Открыть Студию' : 'Open the Studio') : (ru ? 'Открыть Читальный зал' : 'Open the Reading Room')}</a><a class="btn btn-secondary" href={p(studio ? '/products/reading-room' : '/products/linguistpro')}>{studio ? (ru ? 'Выбрать готовый материал' : 'Choose prepared material') : (ru ? 'Создать свой материал' : 'Make your own material')}</a></div>
  </div>
  {studio ? <>
    <LearningFlow />
    <div class="feature-pairs">{[capabilities[0], capabilities[1]].map(c => <article id={c.id}><h2>{c.title[lang]}</h2><p>{c.text[lang]}</p></article>)}</div>
    <div class="product-body"><h2>{ru ? 'От источника к учебной строке' : 'From source to study text'}</h2>
    <p>{ru ? 'Вставьте текст, укажите адрес статьи или откройте файл в Центре импорта. Проверьте распознанный текст перед созданием таблицы. Сохраняйте материал, возвращайтесь к нему в Студии или Зале и экспортируйте переносимый пакет.' : 'Paste text, enter an article URL or open a file in the Import Center. Check the extracted text before creating the table. Save the material, return to it in the Studio or Reading Room and export a portable package.'}</p>
    <p>{ru ? 'Для аудио и видео доступна обработка длинных записей до 3 часов / 300 МБ с учётом выбранного маршрута. Субтитры VTT/SRT сохраняют сегменты. Подсветка следует медиа только при надёжных временных метках; проблемы распознавания и тайминга показаны отдельно.' : 'Audio and video processing supports long recordings up to 3 hours / 300 MB, subject to the selected route. VTT/SRT captions preserve segments. Highlighting follows the media where timestamps are reliable; transcription and timing problems are shown separately.'}</p>
    <p>{ru ? 'Для YouTube приносите свои субтитры или расшифровку. Автоматическое скачивание произвольного видео не заявлено как общедоступная возможность.' : 'For YouTube, bring your own captions or transcript. Automatic downloading of arbitrary remote videos is not announced as a generally available feature.'}</p>
    <h2>{ru ? 'Сложный текст можно упростить отдельно' : 'Make a separate, simpler version'}</h2><p>{ru ? 'Создайте пересказ уровня A1–B2 и сравните покрытие знакомой лексикой. Сохранённый оригинал остаётся отдельным материалом. Если вы заменяете несохранённый текст в редакторе, приложение просит подтверждение.' : 'Create an A1–B2 retelling and compare recorded vocabulary coverage. A saved original remains a separate material. Replacing unsaved editor text requires confirmation.'}</p></div>
    <details class="demo-disclosure"><summary>{ru ? 'Посмотреть короткое видео о рабочем пространстве' : 'Watch a short workspace overview'}</summary>
    <video class="demo-video" src="/media/linguistpro-demo.mp4" poster="/media/linguistpro-demo-poster.jpg" width="1280" height="720" muted playsinline controls preload="none" aria-label={ru ? 'Обзор ранней версии LinguistPro' : 'Earlier LinguistPro workspace overview'}></video><p class="small muted">{ru ? 'Архивный обзор интерфейса. Актуальные возможности описаны на этой странице.' : 'An earlier interface overview. Current capabilities are described on this page.'}</p></details>
  </> : <>
    <CorpusShelf lang={lang} />
    <details class="interface-preview"><summary>{ru ? 'Посмотреть интерфейс Читального зала' : 'See the Reading Room interface'}</summary><Screenshot src="/img/reading-room-current.png" width={1360} height={1040} alt={ru ? 'Читальный зал LinguistPro: публичные учебные песни, поиск, сортировка и карточки с состоянием аудио; вход без аккаунта.' : 'LinguistPro Reading Room in Russian: public Study Songs, search, sorting and cards with audio availability, opened without an account.'} caption={ru ? 'Открытая коллекция «Учебные песни». Снимок действующего приложения, сентябрь 2026.' : 'The public Study Songs collection. Captured from the live application in September 2026.'} /></details>
    <div class="product-body"><h2>{ru ? 'Литература с понятными границами' : 'Literature with a clear starting point'}</h2><p>{ru ? 'Каталог основан на материалах проекта Бен-Иегуда. Он объединяет поэзию, прозу, статьи и другие жанры, разные эпохи и языки исходных записей. Перейдите от периода к автору и произведению; подготовленные материалы дают опору для чтения на иврите с русским переводом.' : 'The catalog is based on Project Ben-Yehuda, bringing together poetry, prose, articles and other genres across periods and source languages. Move from period to author to work; prepared materials support Hebrew reading with Russian translation.'}</p><p>{ru ? 'Число подготовленных записей — показатель каталога, а не обещание наличия всех переводов, аудио или морфологических данных. Источник и состояние подготовки видны в карточке. Машинный перевод помогает читать, но не заменяет оригинал или редакторскую проверку.' : 'The prepared count is a catalog indicator, not a promise that every translation, audio file or morphological annotation is available. Each card shows its source and preparation status. Machine translation supports reading; it does not replace the original or editorial checking.'}</p><p><a href="https://benyehuda.org/">{ru ? 'Открыть проект Бен-Иегуда' : 'Visit Project Ben-Yehuda'}</a></p>
    <h2 id="physics-year1">{ru ? 'Учебная задача: сначала условие, затем решение' : 'Study problems: read, attempt, then check'}</h2><p>{ru ? 'В задачниках физики и материаловедения условие на иврите сопровождается огласовками, транслитерацией и русским переводом. Сначала попробуйте решить задачу; затем откройте проверенный ответ и подробный ход решения. Условия и авторские учебные решения различаются по происхождению.' : 'Physics and materials-science problems pair the Hebrew condition with niqqud, transliteration and Russian translation. Try solving first, then reveal the reviewed answer and full walkthrough. Source conditions and independently authored learning solutions have distinct provenance.'}</p><p>{ru ? 'Полное решение раскрывает дано, искомое, систему единиц, физическую модель, вывод формул, расчёты и проверку. Это независимый учебный материал; он не означает аффилиации с учебным заведением или издателем исходного задачника.' : 'A full solution develops the givens, target quantity, units, physical model, formula derivation, arithmetic and checks. This is an independent learning aid, without a claim of affiliation with a college or the source publisher.'}</p>
    <h2>{ru ? 'Выбор по записанному знанию слов' : 'Choose using your recorded vocabulary'}</h2><p>{capabilities[4].text[lang]} {ru ? 'Отсутствие данных отличается от 0%. Поиск, фильтры и продолжение чтения помогают вернуться к нужному тексту.' : 'Missing data is distinct from 0%. Search, filters and Continue Reading help you return to the right text.'}</p></div>
  </>}
  <section class="method-section"><h2>{ru ? 'Общий учебный инструмент в Студии и Зале' : 'One learning workspace across Studio and Reading Room'}</h2><div class="feature-pairs">{[capabilities[2], capabilities[3], capabilities[5]].map(c => <article id={c.id}><h3>{c.title[lang]}</h3><p>{c.text[lang]}</p></article>)}</div></section>
  <div class="product-body"><h2>{ru ? 'Локальная база и осознанная обработка' : 'Local data and deliberate processing choices'}</h2><p>{facts.boundaries[lang]}</p><div class="inline-links"><a href={p('/privacy')}>{ru ? 'Данные и конфиденциальность' : 'Data and privacy'}</a><a href={p('/technology')}>{ru ? 'Технологии' : 'Technology'}</a><a href={p('/agents')}>{ru ? 'Доступ для агентов' : 'Agent access'}</a></div>
  <h2>{ru ? 'Исследование и проверяемость' : 'Research and checkable sources'}</h2><p>{ru ? 'LinguistPro включает отдельный исследовательский режим с явным согласием. Методология пререгистрирована на OSF; пререгистрация сама по себе не доказывает эффективность обучения.' : 'LinguistPro includes a separate research mode with explicit consent. Its methodology is preregistered at OSF; preregistration alone does not establish learning effectiveness.'}</p><div class="inline-links"><a href="https://osf.io/zdv9j">OSF</a><a href={facts.repository}>GitHub</a></div></div>
  <Questions lang={lang} />
  <section class="agent-invitation"><h2>{ru ? 'Начните с одного материала' : 'Start with one material'}</h2><p>{ru ? 'Выберите короткий текст, прочитайте несколько строк и сохраните одно полезное слово.' : 'Choose a short text, read a few lines and save one useful word.'}</p><div class="btn-row"><a class="btn btn-primary" href={studio ? facts.studio : facts.room}>{studio ? (ru ? 'Открыть Студию' : 'Open the Studio') : (ru ? 'Открыть Читальный зал' : 'Open the Reading Room')}</a><a class="btn btn-secondary" href={p('/guides/hebrew-reading')}>{ru ? 'Как организовать чтение' : 'Plan a reading session'}</a></div></section>
  <p class="source-note">{ru ? 'Сведения проверены' : 'Information reviewed'} <time datetime={facts.reviewed}>{facts.reviewed}</time>. <a href={p('/agents#sources')}>{ru ? 'Источники и ограничения' : 'Sources and boundaries'}</a>.</p>
</BaseLayout>
