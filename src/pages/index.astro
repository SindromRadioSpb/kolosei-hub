---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Hero from '../components/Hero.astro';
import GcpStrip from '../components/GcpStrip.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

// Aggregate the Google Cloud services actually in production across products.
const gcpServices = [...new Set(projects.flatMap((p) => p.data.gcpServices))];
---
<BaseLayout
  title="Kolosei"
  home={true}
  description="Kolosei builds local-first Hebrew learning tools. LinguistPro turns articles, documents, images, audio, video and captions into an interactive workspace for reading, understanding and remembering Hebrew."
>
  <Hero
    eyebrow="AI studio · Hebrew language tools"
    title="AI-powered Hebrew language tools"
    lead="Kolosei is a founder-led studio building software for learning and understanding Hebrew. Our flagship, LinguistPro, turns real-world sources — from articles and PDFs to audio, video and captions — into a workspace for reading, understanding and remembering."
    ctas={[
      { href: '/products/linguistpro', label: 'Explore LinguistPro', primary: true },
      { href: '/technology', label: 'Built on Google Cloud' },
    ]}
  />

  <p>
    Two shipping Hebrew products and one health-AI research vertical, all built and run by founder
    <a href="/about">Peter Kolosei</a>. The work is privacy-first by design and grounded in
    preregistered language-pedagogy research.
  </p>

  <h2>Products</h2>
  <div class="grid-projects">
    {projects.map((p) => (
      <ProjectCard
        title={p.data.title}
        tagline={p.data.tagline}
        partOf={p.data.partOf}
        description={p.data.description}
        status={p.data.status}
        domain={p.data.domain}
        url={p.data.url}
        repo={p.data.repo}
        statusPage={p.data.statusPage}
        detailUrl={p.data.detailUrl}
        gcpServices={p.data.gcpServices}
      />
    ))}
  </div>
  <p class="small"><a href="/products">All products →</a></p>

  <p class="reading-room-note small">
    <strong>New in the v3.11 series — sources become lessons.</strong> Import articles, documents,
    photos, audio, video and captions; build a source-aware Hebrew table, follow long media with
    karaoke and simplify a separate copy to A1–B2.
    <a href="/products/linguistpro">See the full learning loop →</a>
  </p>

  <section class="band">
    <h2>Built on Google Cloud</h2>
    <p>
      AI is used where it adds measurable value, not as the authority for every answer. LinguistPro and
      HDLE Premium use Google Cloud in production; LinguistPro combines that compute with deterministic
      morphology, local storage and explicit consent for optional server features.
    </p>
    <GcpStrip services={gcpServices} compact={false} />
  </section>

  <section class="band">
    <h2>Why this is credible</h2>
    <ul class="traction">
      <li><strong>In production</strong><span>The LinguistPro v3.11 series runs on Hetzner + Coolify, with public uptime monitoring.</span></li>
      <li><strong>Real Google Cloud usage</strong><span>Gemini API, Cloud Text-to-Speech and Cloud Translation v3 — in two shipping products.</span></li>
      <li><strong>Local-first architecture</strong><span>The primary workspace stays in browser-local OPFS; sync, research, Telegram and agent access are separate opt-in capabilities.</span></li>
      <li><strong>Preregistered research</strong><span>An ulpan-cohort study preregistered at OSF (osf.io/zdv9j), supporting a Hebrew-pedagogy diploma.</span></li>
    </ul>
  </section>
</BaseLayout>
