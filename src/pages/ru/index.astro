---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import Hero from '../../components/Hero.astro';
import GcpStrip from '../../components/GcpStrip.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

const gcpServices = [...new Set(projects.flatMap((p) => p.data.gcpServices))];
---
<BaseLayout
  title="Kolosei"
  home={true}
  description="Kolosei создаёт local-first инструменты для изучения иврита. LinguistPro превращает статьи, документы, изображения, аудио, видео и субтитры в интерактивное пространство для чтения, понимания и запоминания."
>
  <Hero
    eyebrow="AI-студия · инструменты для иврита"
    title="AI-инструменты для иврита"
    lead="Kolosei — студия одного основателя, создающая софт для изучения и понимания иврита. Наш флагман LinguistPro превращает живые источники — от статей и PDF до аудио, видео и субтитров — в пространство для чтения, понимания и запоминания."
    ctas={[
      { href: '/ru/products/linguistpro', label: 'Открыть LinguistPro', primary: true },
      { href: '/ru/technology', label: 'Построено на Google Cloud' },
    ]}
  />

  <p>
    Два работающих продукта для иврита и одна health-AI исследовательская вертикаль — всё создано и
    поддерживается основателем <a href="/ru/about">Петром Колосеем</a>. Работа privacy-first по замыслу
    и опирается на пререгистрированное исследование по педагогике языка.
  </p>

  <h2>Продукты</h2>
  <div class="grid-projects">
    {projects.map((p) => (
      <ProjectCard
        lang="ru"
        title={p.data.title}
        tagline={p.data.tagline_ru}
        partOf={p.data.partOf}
        description={p.data.description_ru}
        status={p.data.status}
        domain={p.data.domain}
        url={p.data.url}
        repo={p.data.repo}
        statusPage={p.data.statusPage}
        detailUrl={p.data.detailUrl ? '/ru' + p.data.detailUrl : undefined}
        gcpServices={p.data.gcpServices}
      />
    ))}
  </div>
  <p class="small"><a href="/ru/products">Все продукты →</a></p>

  <p class="reading-room-note small">
    <strong>Новое в серии v3.11 — источник становится уроком.</strong> Импортируйте статьи, документы,
    фотографии, аудио, видео и субтитры; создавайте построчную таблицу с привязкой к источнику,
    следите за длинными медиа в караоке и упрощайте отдельную копию до A1–B2.
    <a href="/ru/products/linguistpro">Посмотреть весь учебный цикл →</a>
  </p>

  <section class="band">
    <h2>Построено на Google Cloud</h2>
    <p>
      AI используется там, где даёт измеримую пользу, а не как авторитет для каждого ответа.
      LinguistPro и HDLE Premium работают с Google Cloud; LinguistPro сочетает облачные вычисления с
      детерминированной морфологией, локальным хранилищем и явным согласием для опциональных серверных функций.
    </p>
    <GcpStrip services={gcpServices} compact={false} />
  </section>

  <section class="band">
    <h2>Почему это убедительно</h2>
    <ul class="traction">
      <li><strong>В продакшене</strong><span>Серия LinguistPro v3.11 работает на Hetzner + Coolify, с публичным мониторингом аптайма.</span></li>
      <li><strong>Реальное использование Google Cloud</strong><span>Gemini API, Cloud Text-to-Speech и Cloud Translation v3 — в двух работающих продуктах.</span></li>
      <li><strong>Local-first архитектура</strong><span>Основное рабочее пространство остаётся в OPFS браузера; sync, исследования, Telegram и доступ агента включаются отдельно.</span></li>
      <li><strong>Пререгистрированное исследование</strong><span>Когортное исследование ульпана, пререгистрированное на OSF (osf.io/zdv9j), в рамках диплома по педагогике иврита.</span></li>
    </ul>
  </section>
</BaseLayout>
